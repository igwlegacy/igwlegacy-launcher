# Fills the toolchain's (otherwise empty) find root with what FLTK needs to
# build its X11 + Xft backend on Linux, without any host libraries:
#
#   <find root>/usr/include   headers of the vendored X11/Xft/fontconfig/
#                             freetype submodules, laid out as installed
#   <find root>/usr/lib       stub shared objects carrying the real SONAMEs
#
# The stubs define every exported function of the respective library as an
# empty body and exist only so that the linker records DT_NEEDED entries such
# as libX11.so.6. They are never shipped: at runtime the dynamic loader picks
# up the real system libraries, which every X11 desktop has installed.
#
# Because the find root is where CMAKE_FIND_ROOT_PATH points, the stock
# FindX11, FindFreetype and FindFontconfig modules (used by FLTK) discover
# these files exactly as they would on a regular system.

include_guard(GLOBAL)

set(_igwl_vendor "${PROJECT_SOURCE_DIR}/vendor")
set(_igwl_sysroot "${CMAKE_FIND_ROOT_PATH}/usr")
set(_igwl_sysroot_include "${_igwl_sysroot}/include")
set(_igwl_sysroot_lib "${_igwl_sysroot}/lib")

file(MAKE_DIRECTORY "${_igwl_sysroot_include}" "${_igwl_sysroot_lib}")

# --- Headers -----------------------------------------------------------------

# Copies the header tree `source` into `destination`; only *.h files, so the
# build system files of the submodules stay behind. file(COPY) skips files
# whose timestamp did not change, so re-running CMake does not touch them.
function(_igwl_copy_headers source destination)
    file(COPY "${source}/" DESTINATION "${destination}"
         FILES_MATCHING PATTERN "*.h")
endfunction()

# Writes `content` to `path` only if it differs, so that rebuilding is not
# triggered by a mere re-configure.
function(_igwl_write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" _existing)
        if(_existing STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

_igwl_copy_headers("${_igwl_vendor}/xorgproto/include/X11" "${_igwl_sysroot_include}/X11")
_igwl_copy_headers("${_igwl_vendor}/libx11/include/X11" "${_igwl_sysroot_include}/X11")
_igwl_copy_headers("${_igwl_vendor}/libxrender/include/X11" "${_igwl_sysroot_include}/X11")
_igwl_copy_headers("${_igwl_vendor}/libxft/include/X11" "${_igwl_sysroot_include}/X11")
_igwl_copy_headers("${_igwl_vendor}/fontconfig/fontconfig" "${_igwl_sysroot_include}/fontconfig")
# freetype installs into include/freetype2, which is where FindFreetype and
# the `#include <ft2build.h>` convention (via -I.../freetype2) expect it.
_igwl_copy_headers("${_igwl_vendor}/freetype/include" "${_igwl_sysroot_include}/freetype2")

# A few headers are generated by the projects' build systems. The values below
# mirror what their configure steps produce on a glibc system.

# XlibConf.h: libX11 is built thread-safe by every distribution.
file(READ "${_igwl_vendor}/libx11/include/X11/XlibConf.h.in" _igwl_text)
string(REPLACE "#undef XTHREADS" "#define XTHREADS 1" _igwl_text "${_igwl_text}")
string(REPLACE "#undef XUSE_MTSAFE_API" "#define XUSE_MTSAFE_API 1" _igwl_text "${_igwl_text}")
_igwl_write_if_changed("${_igwl_sysroot_include}/X11/XlibConf.h" "${_igwl_text}")

# Xpoll.h: glibc names the fd_set member __fds_bits.
file(READ "${_igwl_vendor}/xorgproto/include/X11/Xpoll.h.in" _igwl_text)
string(REPLACE "@USE_FDS_BITS@" "__fds_bits" _igwl_text "${_igwl_text}")
_igwl_write_if_changed("${_igwl_sysroot_include}/X11/Xpoll.h" "${_igwl_text}")

# Xft.h: the version comes from AC_INIT in configure.ac, which (unlike the
# git tag) is also there in source copies without git metadata, such as the
# scratch tree of `./dev.py repro`.
file(STRINGS "${_igwl_vendor}/libxft/configure.ac" _igwl_xft_init REGEX "^AC_INIT")
string(REGEX MATCH "\\[([0-9]+)\\.([0-9]+)\\.([0-9]+)\\]" _ "${_igwl_xft_init}")
if(CMAKE_MATCH_3 STREQUAL "")
    message(FATAL_ERROR "Could not read the libXft version from its configure.ac")
endif()
file(READ "${_igwl_vendor}/libxft/include/X11/Xft/Xft.h.in" _igwl_text)
string(REPLACE "#undef XFT_MAJOR" "#define XFT_MAJOR ${CMAKE_MATCH_1}" _igwl_text "${_igwl_text}")
string(REPLACE "#undef XFT_MINOR" "#define XFT_MINOR ${CMAKE_MATCH_2}" _igwl_text "${_igwl_text}")
string(REPLACE "#undef XFT_REVISION" "#define XFT_REVISION ${CMAKE_MATCH_3}" _igwl_text "${_igwl_text}")
_igwl_write_if_changed("${_igwl_sysroot_include}/X11/Xft/Xft.h" "${_igwl_text}")

# fontconfig.h: only the cache format numbers are substituted (taken from
# fontconfig's meson.build), and the two attribute macros are left undefined
# just like its configure step does.
file(READ "${_igwl_vendor}/fontconfig/meson.build" _igwl_fc_meson)
foreach(_igwl_name cacheversion cachemincompat cachesnapversion)
    string(REGEX MATCH "\n${_igwl_name} = ([0-9]+)" _ "${_igwl_fc_meson}")
    if(CMAKE_MATCH_1 STREQUAL "")
        message(FATAL_ERROR "Could not read ${_igwl_name} from fontconfig's meson.build")
    endif()
    set(_igwl_fc_${_igwl_name} "${CMAKE_MATCH_1}")
endforeach()
if(_igwl_fc_cachesnapversion GREATER 0)
    math(EXPR _igwl_fc_nextcacheversion "${_igwl_fc_cacheversion} + 1")
else()
    set(_igwl_fc_nextcacheversion 0)
endif()
file(READ "${_igwl_vendor}/fontconfig/fontconfig/fontconfig.h.in" _igwl_text)
string(REPLACE "@CACHE_VERSION@" "${_igwl_fc_cacheversion}" _igwl_text "${_igwl_text}")
string(REPLACE "@CACHE_MIN_COMPAT_VERSION@" "${_igwl_fc_cachemincompat}" _igwl_text "${_igwl_text}")
string(REPLACE "@CACHE_SNAP_VERSION@" "${_igwl_fc_cachesnapversion}" _igwl_text "${_igwl_text}")
string(REPLACE "@NEXT_CACHE_VERSION@" "${_igwl_fc_nextcacheversion}" _igwl_text "${_igwl_text}")
_igwl_write_if_changed("${_igwl_sysroot_include}/fontconfig/fontconfig.h" "${_igwl_text}")

# --- Stub libraries ----------------------------------------------------------

# Builds <find root>/usr/lib/<soname> from cmake/linux-stubs/<soname>.symbols
# and adds the unversioned lib<name>.so link that find_library() looks for.
function(_igwl_stub_library soname)
    set(_symbols "${PROJECT_SOURCE_DIR}/cmake/linux-stubs/${soname}.symbols")
    set(_source "${CMAKE_BINARY_DIR}/linux-stubs/${soname}.c")
    set(_library "${_igwl_sysroot_lib}/${soname}")

    # Re-run CMake when a symbol list is regenerated.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_symbols}")

    # The stubs are compiled without any header, so the signatures do not
    # matter; the linker only looks at the symbol names.
    file(STRINGS "${_symbols}" _names)
    set(_code "/* Generated by cmake/LinuxSysroot.cmake from ${soname}.symbols */\n")
    foreach(_name IN LISTS _names)
        string(APPEND _code "void ${_name}(void) {}\n")
    endforeach()
    _igwl_write_if_changed("${_source}" "${_code}")

    if(NOT EXISTS "${_library}" OR "${_source}" IS_NEWER_THAN "${_library}")
        message(STATUS "Building link stub ${soname}")
        execute_process(
            COMMAND "${CMAKE_C_COMPILER}" -shared -fPIC -nostdlib -w
                    "-Wl,-soname,${soname}" -o "${_library}" "${_source}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()

    # libX11.so.6 -> libX11.so
    string(REGEX REPLACE "\\.so\\..*$" ".so" _link_name "${soname}")
    file(CREATE_LINK "${soname}" "${_igwl_sysroot_lib}/${_link_name}" SYMBOLIC)
endfunction()

foreach(_igwl_soname
        libX11.so.6
        libXrender.so.1
        libXft.so.2
        libfontconfig.so.1
        libfreetype.so.6)
    _igwl_stub_library(${_igwl_soname})
endforeach()

# FindFontconfig and FindFreetype try pkg-config first, which would report the
# build machine's libraries. Without it they fall back to plain find_path /
# find_library calls, which stay inside the find root.
set(CMAKE_DISABLE_FIND_PACKAGE_PkgConfig TRUE)
