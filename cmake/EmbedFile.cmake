# Turns a file into a C++ source defining its bytes as an array, so assets
# such as the logo are part of the executable. Run in script mode:
#
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P EmbedFile.cmake
#
# The result defines, in namespace igwl::assets,
#
#   extern const unsigned char <SYMBOL>[];      the file's bytes
#   extern const std::size_t <SYMBOL>_size;     their number
#
# which src/assets.h declares. Only the file name of INPUT ends up in the
# output, never its absolute path, so the generated source (and thus the
# binary) does not depend on where the checkout lives.

foreach(_variable INPUT OUTPUT SYMBOL)
    if(NOT DEFINED ${_variable})
        message(FATAL_ERROR "EmbedFile.cmake: -D${_variable}=... is missing")
    endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hex_length)
if(_hex_length EQUAL 0)
    # A zero-sized array is not valid C++.
    message(FATAL_ERROR "EmbedFile.cmake: ${INPUT} is empty")
endif()

# 32 bytes (64 hex digits) per line keeps the generated file readable;
# CMake's regular expressions have no {n} repetition, hence the dots.
string(REGEX REPLACE
    "(................................................................)" "\\1\n    "
    _hex "${_hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")

get_filename_component(_name "${INPUT}" NAME)
file(WRITE "${OUTPUT}" "\
// Generated by cmake/EmbedFile.cmake from ${_name}; do not edit.
#include \"assets.h\"

namespace igwl {
namespace assets {

extern const unsigned char ${SYMBOL}[] = {
    ${_bytes}
};
extern const std::size_t ${SYMBOL}_size = sizeof ${SYMBOL};

}  // namespace assets
}  // namespace igwl
")
